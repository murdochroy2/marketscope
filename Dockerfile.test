# Runs both test suites in one container: `docker compose run --rm --build tests`.
# Source is copied in, not mounted, so it behaves the same on Linux, macOS and Windows.

FROM node:22-bookworm-slim AS node

FROM python:3.11-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.6.5 /uv /usr/local/bin/uv
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1 CI=true
WORKDIR /repo

# Dependencies first, so code changes don't reinstall them.
COPY backend/pyproject.toml backend/uv.lock backend/
RUN cd backend && uv sync --frozen --no-install-project
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc frontend/
RUN cd frontend && npm ci --no-audit --no-fund

# The backend tests read samples/ from the repo root.
COPY backend backend
COPY frontend frontend
COPY samples samples
RUN cd backend && uv sync --frozen

CMD ["sh", "-c", "cd backend && uv run --frozen pytest && cd ../frontend && npx vitest run"]
