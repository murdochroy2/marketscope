# Copy to .env (repo root for Docker, or backend/.env for local runs). Every value is optional.

# Store discovery: overpass (free, default) | google | fixture (offline, captured OSM data)
PLACES_PROVIDER=overpass
# Required only when PLACES_PROVIDER=google. Enable "Places API (New)" on the key's project.
GOOGLE_PLACES_API_KEY=

# Geocoding for city boundaries and portfolio rows without coordinates: nominatim | fixture
GEOCODER=nominatim
# Nominatim's usage policy asks for a User-Agent that identifies you and a way to contact you.
NOMINATIM_USER_AGENT="MarketScope/0.1 (you@example.com)"

# Guardrails
MAX_MARKET_AREA_SQ_KM=30
MAX_PROVIDER_REQUESTS_PER_MARKET=400

# Local runs only; Docker Compose sets this for you.
DATABASE_URL=postgresql+asyncpg://marketscope:marketscope@localhost:5432/marketscope
